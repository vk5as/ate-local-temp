#!/bin/sh
# postinst for the ATE .deb (packet 28b). dpkg runs this after the bundle has been laid down in
# /opt/ate; "ate setup" creates the data directories and the config directory, writes a default
# /etc/ate/config.json only when none exists, and creates or upgrades the database
# (assets/packaging.md: "Preparing a Station"). setup is idempotent, so this also runs on an
# upgrade without touching existing config or data.
#
# Test seam: ATE_DEB_ROOT prefixes every path below so a test can run this script against a
# temporary root instead of the real /opt, /etc and /var. Unset, the real paths are used.
set -e

ROOT=${ATE_DEB_ROOT:-}
ATE="$ROOT/opt/ate/ate"

if [ "$1" = "configure" ] || [ "$1" = "reconfigure" ]; then
    if [ ! -x "$ATE" ]; then
        echo "postinst: $ATE is missing or not executable - the package is broken" >&2
        exit 1
    fi
    if "$ATE" setup; then
        echo "ate setup: Station prepared"
    else
        echo "postinst: 'ate setup' failed; run it by hand as root: $ATE setup" >&2
        exit 1
    fi
fi

exit 0
