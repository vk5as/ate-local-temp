{# ATE HTML Test Report (ticket 21). Inline CSS + CSS @page margin boxes (Chromium / QWebEngine),
   self-contained with no external assets. The logo is a base64 data URI. Only reports.organisation,
   reports.logo and reports.paperSize customise it in v1.

   Packet 21a builds the Cover section here; the Steps section is packet 21b and Equipment /
   Configuration / Run log are packet 21c — they are left as clearly-marked placeholders so this
   packet's scope stays whole. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc_title or "Test Report" }} · {{ uut_type }} {{ uut_serial }}</title>
<style>
@page {
  size: {{ paper }} portrait;
  margin: {{ page_margin_css }};
  @top-left   { content: url("{{ logo }}"); vertical-align: middle; width: 32mm; }
  @top-center { content: "{{ org ~ ' · ' ~ (doc_title or '') ~ ' · ' ~ (doc_id or '') ~ ' rev ' ~ (doc_rev or '') }}"; font: 8pt sans-serif; color: #333; text-align: left; vertical-align: middle; }
  @top-right  { content: "{{ uut_type }} {{ uut_serial }}"; font: bold 9pt sans-serif; border-bottom: none; }
  @bottom-left{ content: "{{ run_ftr }}"; font: 7pt sans-serif; color: #555; width: 150mm; }
  @bottom-right { content: "Page " counter(page) " of " counter(pages); font: 8pt sans-serif; }
}
@media screen { body { max-width: 190mm; margin: 1em auto; } }
@media print { .screen-only { display: none; } }
body { font-family: "DejaVu Sans", "Segoe UI", Arial, sans-serif; font-size: 9pt; color: #111; }
h1 { font-size: 16pt; margin: 0 0 2mm 0; }
h2 { font-size: 12pt; margin: 6mm 0 2mm 0; border-bottom: 0.4mm solid #1f4e8c; padding-bottom: 1mm; color: #1f4e8c; }
table { border-collapse: collapse; width: 100%; }
th, td { text-align: left; vertical-align: top; padding: 1mm 1.5mm; }
.kv th { width: 35mm; color: #555; font-weight: normal; }
.banner { border: 0.5mm solid #b36b00; background: #fff4e0; color: #6b3e00; padding: 2mm 3mm; margin: 2mm 0; font-weight: bold; }
.verdict { font-size: 34pt; font-weight: bold; letter-spacing: 1mm; padding: 2mm 4mm; border: 1mm solid; text-align: center; }
.verdict-pass { color: #146c2e; border-color: #146c2e; }
.verdict-fail { color: #a4161a; border-color: #a4161a; }
.endreason { text-align: center; color: #333; font-size: 10pt; margin-top: 1mm; }
.small { font-size: 7.5pt; color: #444; }
.sig { border: 0.4mm solid #333; height: 26mm; width: 80mm; }
.sigline { border-bottom: 0.3mm solid #333; height: 7mm; width: 50mm; }
.counts td, .counts th { border: 0.2mm solid #bbb; text-align: center; }
.res { font-weight: bold; }
.res-pass { color: #146c2e; } .res-fail, .res-error, .res-noreport { color: #a4161a; }
.res-skipped, .res-notrun, .res-forced_notrun { color: #777; }
.mono { font-family: "DejaVu Sans Mono", Consolas, monospace; font-size: 7pt; word-break: break-all; }
</style>
</head>
<body>

{% if org %}
<div class="screen-only">
  <table><tr>
    <td style="width: 34mm"><img src="{{ logo }}" style="height: 9mm"></td>
    <td>{{ org }} · {{ doc_title or '' }} · {{ doc_id or '' }} rev {{ doc_rev or '' }}</td>
    <td style="text-align: right; font-weight: bold">{{ uut_type }} {{ uut_serial }}</td>
  </tr></table>
</div>
{% endif %}

<!-- ============ Cover ============ -->
<h1>{{ doc_title or "Test Report" }}</h1>
<div class="small">{{ doc_id or '—' }}{% if doc_rev %} · revision {{ doc_rev }}{% endif %}</div>

{% if interrupted %}<div class="banner">⚠ This Test Run was INTERRUPTED and did not finish.</div>{% endif %}
{% if checksum_mismatch %}<div class="banner">⚠ One or more files did not match their recorded checksum. See Configuration (packet 21c).</div>{% endif %}
{% if pretest_failed_schedule %}<div class="banner">⚠ {{ pretest_failed_schedule.name }} failed: {{ pretest_failed_schedule.error }}</div>{% endif %}
{% if posttest_failed_schedule %}<div class="banner">⚠ {{ posttest_failed_schedule.name }} errored: {{ posttest_failed_schedule.error }}</div>{% endif %}

<table style="margin-top: 4mm"><tr>
  <td style="width: 60%">
    <table class="kv">
      <tr><th>UUT Type</th><td>{{ uut_type }}</td></tr>
      <tr><th>Serial</th><td><b>{{ uut_serial }}</b></td></tr>
      <tr><th>Project</th><td>{{ project }}</td></tr>
      <tr><th>Station</th><td>{{ station }}</td></tr>
      <tr><th>Start</th><td>{{ start_local }}</td></tr>
      <tr><th>End</th><td>{{ end_local or '—' }}</td></tr>
      <tr><th>Duration</th><td>{{ duration or '—' }}</td></tr>
      <tr><th>ATE version</th><td>{{ ate_version }}</td></tr>
      <tr><th>Stop on Fail</th><td>{{ 'on' if stop_on_fail else 'off' }}</td></tr>
      <tr><th>Schedule</th><td>{{ schedule_name }}{% if schedule_description %}<br><span class="small">{{ schedule_description }}<br>{{ schedule_file or '' }}</span>{% endif %}</td></tr>
      <tr><th>Media Release</th><td>{{ media_number }}{% if media_name %} — {{ media_name }} v{{ media_version }}{% endif %}</td></tr>
    </table>
  </td>
  <td style="width: 40%">
    <div class="verdict verdict-{{ 'pass' if result == 'PASS' else 'fail' }}">{{ result }}</div>
    <div class="endreason">End Reason: {{ end_reason or '—' }}</div>
  </td>
</tr></table>

<h2>Summary</h2>
<table class="counts"><tr>{% for r in result_labels %}<th class="small">{{ r }}</th>{% endfor %}</tr>
<tr>{% for r in result_labels %}<td class="{{ 'res ' ~ r|lower }}">{{ counts[r] }}</td>{% endfor %}</tr></table>
<p class="small">Retried steps: {{ retried_steps }} · Operator enable overrides: {{ operator_overrides }}</p>

{% if failures %}
<h2>Failures</h2>
<table>
{% for f in failures %}<tr><td style="width: 16mm">{{ f.number }}</td><td>{{ f.name }}<br><span class="small">{{ f.message }}</span></td><td style="width: 26mm" class="{{ 'res ' ~ f.result|lower }}">{{ f.result }}</td></tr>{% endfor %}
</table>
{% endif %}

<h2>Operator</h2>
<table><tr>
  <td style="width: 50%">{{ operator }}<br><br><span class="small">Date</span><div class="sigline"></div></td>
  <td><span class="small">Signature</span><div class="sig"></div></td>
</tr></table>

<!-- ============ Steps (packet 21b) — TODO: one row per expanded-tree node, indented headers and
     retried-step sub-rows. Placeholder until 21b is implemented. ============ -->
<h2 class="page-break">Steps</h2>
<p class="small"><i>[placeholder — packet 21b]</i></p>

<!-- ============ Equipment (packet 21c) — TODO: declared equipment in declaration order, or
     "No equipment declared." Placeholder until 21c is implemented. ============ -->
<h2 class="page-break">Equipment</h2>
<p class="small"><i>[placeholder — packet 21c]</i></p>

<!-- ============ Configuration (packet 21c) — TODO: Media Releases, Files and Sub-schedule
     instances used by this run. Placeholder until 21c is implemented. ============ -->
<h2>Configuration</h2>
<p class="small"><i>[placeholder — packet 21c]</i></p>

<!-- ============ Run log (packet 21c) — TODO: INFO/WARNING/ERROR lines grouped by owner, in time
     order within each group. Always included at run end; placeholder until 21c is implemented. ============ -->
<h2 class="page-break">Run log</h2>
<p class="small"><i>[placeholder — packet 21c]</i></p>

</body>
</html>
